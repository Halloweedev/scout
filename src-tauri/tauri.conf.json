{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scout",
  "version": "0.1.0",
  "identifier": "dev.halloweedev.scout",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scout",
        "width": 1240,
        "height": 780,
        "minWidth": 900,
        "minHeight": 580,
        "backgroundColor": "#0b0b0c",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
